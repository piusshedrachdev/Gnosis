{
  "manifest_version": 3,
  "name": "Class Value Extractor",
  "version": "1.1",
  "description": "Extracts text from a user-specified class after DOM changes stop, validates it against the Agent Runtime /execute contract, and forwards it when it matches.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["parser.js", "capability_prompt.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Class Value Extractor",
    "default_popup": "options.html"
  }
}
